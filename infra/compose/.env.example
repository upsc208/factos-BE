# docker compose용 환경 변수. 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 올리지 않는다)
#   cp .env.example .env

# ── 사이트 ───────────────────────────────────────────────
# 사용자가 여는 주소. 프론트·API·로그인 콜백·CORS가 모두 이 값을 쓴다 (같은 출처)
SITE_URL=https://fipa-news.kr
# nginx가 여는 포트 (서버는 80. 로컬에서 80이 막혀 있으면 8088 등)
NGINX_PORT=80

# ── DB (compose 안의 postgres 컨테이너) ─────────────────────
POSTGRES_DB=factos
POSTGRES_USER=factos
POSTGRES_PASSWORD=change-me

# ── 백엔드 비밀값 ─────────────────────────────────────────
GEMINI_API_KEY=
RAPIDAPI_KEY=
ADMIN_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
CHAT_IP_SALT=

# 로그인 (비우면 로그인 전체가 꺼진다)
AUTH_TOKEN_SECRET=
# 로그인 JWT 서명 키 (EC P-256 JWK → base64). 비우면 재시작마다 전원 로그아웃. 만들기:
#   node -e "const k=require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'});console.log(Buffer.from(JSON.stringify(k)).toString('base64'))"
AUTH_JWT_KEY=
# http로 여는 로컬에서는 false (Secure 쿠키는 https에서만 저장된다)
AUTH_COOKIE_SECURE=true
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 라이브 골 알림 (기본 켜짐)
LIVE_FEED_ENABLED=true

# ── travel-svc (자기 DB) ───────────────────────────────
TRAVEL_DB_PASSWORD=change-me-too
# 펍 추가 같은 관리자 API(/api/travel/admin) 키. 비우면 잠긴다
TRAVEL_ADMIN_KEY=

# ── 크롤러 ───────────────────────────────────────────────
# 번역 모델 폴더 (서버 경로). 비우면 ../../../factos-CRAWLER/models
CRAWLER_MODELS_DIR=
