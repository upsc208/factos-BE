    {
      "id": 7,
      "type": "timeseries",
      "title": "일별 여행 글 (KST)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "travel-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "travel-db"
          },
          "rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time, CASE category WHEN 'REVIEW' THEN '직관 후기' WHEN 'TIP' THEN '여행 팁' WHEN 'QUESTION' THEN '질문' ELSE '자유' END AS metric, count(*) AS value FROM post WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
