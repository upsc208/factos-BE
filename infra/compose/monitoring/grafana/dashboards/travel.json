    {
      "id": 8,
      "type": "barchart",
      "title": "팀별 여행 글 (기간)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "travel-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "travel-db"
          },
          "rawSql": "SELECT CASE lower(club) WHEN 'arsenal' THEN '아스날' WHEN 'chelsea' THEN '첼시' WHEN 'liverpool' THEN '리버풀' WHEN 'mancity' THEN '맨시티' WHEN 'man_city' THEN '맨시티' WHEN 'manutd' THEN '맨유' WHEN 'man_utd' THEN '맨유' WHEN 'tottenham' THEN '토트넘' WHEN 'other' THEN '기타' ELSE coalesce(club, '미정') END AS \"팀\", count(*) AS \"글\" FROM post WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
