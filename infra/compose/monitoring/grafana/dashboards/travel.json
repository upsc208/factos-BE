    {
      "id": 12,
      "type": "table",
      "title": "댓글 많은 여행 글 (기간)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "travel-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "travel-db"
          },
          "rawSql": "SELECT p.title AS \"제목\", CASE lower(p.club) WHEN 'arsenal' THEN '아스날' WHEN 'chelsea' THEN '첼시' WHEN 'liverpool' THEN '리버풀' WHEN 'mancity' THEN '맨시티' WHEN 'man_city' THEN '맨시티' WHEN 'manutd' THEN '맨유' WHEN 'man_utd' THEN '맨유' WHEN 'tottenham' THEN '토트넘' WHEN 'other' THEN '기타' ELSE coalesce(p.club, '미정') END AS \"팀\", p.category AS \"말머리\", p.comment_count AS \"댓글\", m.nickname AS \"글쓴이\", p.created_at AS \"작성\" FROM post p LEFT JOIN member_profile m ON m.member_id = p.author_id WHERE $__timeFilter(p.created_at) ORDER BY p.comment_count DESC, p.id DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
