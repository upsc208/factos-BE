          "rawSql": "SELECT city AS \"지역\", count(*) AS \"펍\", count(*) FILTER (WHERE shows_football) AS \"중계\", count(*) FILTER (WHERE club IS NOT NULL) AS \"팀 팬 펍\", max(updated_at) AS \"마지막 갱신\" FROM pub WHERE NOT hidden GROUP BY city ORDER BY 2 DESC",
