    {
      "id": 9,
      "type": "table",
      "title": "제보",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "travel-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "travel-db"
          },
          "rawSql": "SELECT CASE kind WHEN 'ITEM' THEN '경기장 가격' ELSE '펍' END AS \"종류\", CASE lower(club) WHEN 'arsenal' THEN '아스날' WHEN 'chelsea' THEN '첼시' WHEN 'liverpool' THEN '리버풀' WHEN 'mancity' THEN '맨시티' WHEN 'man_city' THEN '맨시티' WHEN 'manutd' THEN '맨유' WHEN 'man_utd' THEN '맨유' WHEN 'tottenham' THEN '토트넘' WHEN 'other' THEN '기타' ELSE coalesce(club, '미정') END AS \"팀\", CASE status WHEN 'PENDING' THEN '대기' WHEN 'APPROVED' THEN '승인' ELSE '거절' END AS \"상태\", count(*) AS \"건수\" FROM guide_report WHERE $__timeFilter(created_at) OR status = 'PENDING' GROUP BY 1, 2, 3 ORDER BY 3, 4 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [],
      "description": "",
